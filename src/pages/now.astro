---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import LocalTimeBadge from '../components/LocalTimeBadge.astro';

const nowEntry = await getEntry('now', 'index');
const { Content } = nowEntry ? await render(nowEntry) : { Content: null };

const formattedDate = nowEntry?.data.updated
  ? new Intl.DateTimeFormat('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(nowEntry.data.updated)
  : null;
---

<Layout title="Now" description="What I am currently focused on.">
  <article class="now-page">
    <header class="now-header">
      <div class="now-header-row">
        <div class="now-header-title-group">
          <h1 class="now-title">Now</h1>
          {
            formattedDate && nowEntry && (
              <p class="now-updated">
                <span class="updated-label">Updated:</span>
                <time datetime={nowEntry.data.updated.toISOString().split('T')[0]}>
                  {formattedDate}
                </time>
              </p>
            )
          }
        </div>
        <LocalTimeBadge />
      </div>
    </header>

    <div class="prose now-body">
      {Content && <Content />}
    </div>

    <footer class="now-colophon">
      <p>
        Inspired by <a
          href="https://sive.rs/now2"
          target="_blank"
          rel="noopener noreferrer">Derek Sivers</a
        > and the <a
          href="https://nownownow.com/about"
          target="_blank"
          rel="noopener noreferrer">nownownow</a
        > movement.
      </p>
    </footer>
  </article>
</Layout>

<style>
  .now-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .now-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-lg);
  }

  .now-header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .now-header-title-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  @media (max-width: 640px) {
    .now-header-row {
      align-items: flex-start;
      gap: var(--space-sm);
    }
  }

  .now-title {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .now-updated {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
  }

  .updated-label {
    color: var(--color-text-muted);
  }

  .now-body {
    font-size: var(--font-size-lg);
    line-height: 1.7;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .now-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: var(--space-sm) 0;
  }

  .now-body :global(p > img) {
    margin: 0;
  }

  .now-body :global(img + em) {
    display: block;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    font-style: normal;
    text-align: center;
    margin-top: calc(-1 * var(--space-xs));
  }

  .now-colophon {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-md);
    margin-top: var(--space-lg);
  }

  .now-colophon p {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
