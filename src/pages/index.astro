---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getSiteConfig } from '../config';

const siteConfig = await getSiteConfig();
const aboutEntry = await getEntry('about', 'index');
const { Content } = aboutEntry ? await render(aboutEntry) : { Content: null };

const aboutData = aboutEntry?.data;
const photoSrc = aboutData?.photo;
const photoAlt = aboutData?.photoAlt || 'About photo';
const photoCaption = aboutData?.photoCaption;
const avatarSrc = aboutData?.avatar;

const onwardLinks = [
  {
    href: '/development',
    title: 'Development',
    description: 'Some of my technical work.',
    key: 'development',
  },
  {
    href: '/travel',
    title: 'Travel',
    description: "I've got things to do and places to be.",
    key: 'travel',
  },
  {
    href: '/music',
    title: 'Music',
    description: 'Put the headphones on.',
    key: 'music',
  },
  {
    href: '/now',
    title: 'Now',
    description: "What I'm currently up to.",
    key: 'now',
  },
];
---

<Layout
  title="About"
  description="Personal website of Abey John, a software engineer."
>
  <article class="about-page">
    <header class="about-header">
      <div class="header-avatar-container">
        {
          avatarSrc && (
            <img
              src={avatarSrc}
              alt={siteConfig.name}
              width={84}
              height={84}
              class="header-avatar"
              loading="eager"
            />
          )
        }
      </div>
      <div class="header-info">
        <h1 class="about-name">{siteConfig.name}</h1>
        <p class="about-meta">
          <span>{siteConfig.role}</span>
          <span class="meta-separator">•</span>
          <span>{siteConfig.location}</span>
        </p>
      </div>
    </header>

    <div class="prose about-intro">
      {Content && <Content />}
    </div>

    {
      photoSrc && (
        <figure class="bio-photo-card">
          <img
            src={photoSrc}
            alt={photoAlt}
            class="bio-photo"
            loading="lazy"
          />
          {photoCaption && (
            <figcaption class="bio-photo-caption">
              {photoCaption}
            </figcaption>
          )}
        </figure>
      )
    }

    <section class="onward-section" aria-labelledby="onward-heading">
      <h2 id="onward-heading" class="onward-heading">Explore</h2>
      <ul class="onward-list">
        {
          onwardLinks.map((link) => (
            <li class="onward-item">
              <a href={link.href} class="onward-link">
                <span class="link-title-wrapper">
                  <span class="card-icon" aria-hidden="true">
                    {link.key === 'development' && (
                      <svg class="card-icon-svg" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="16 18 22 12 16 6" />
                        <polyline points="8 6 2 12 8 18" />
                      </svg>
                    )}
                    {link.key === 'travel' && (
                      <svg class="card-icon-svg" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
                      </svg>
                    )}
                    {link.key === 'music' && (
                      <svg class="card-icon-svg" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 18V5l12-2v13" />
                        <circle cx="6" cy="18" r="3" />
                        <circle cx="18" cy="16" r="3" />
                      </svg>
                    )}
                    {link.key === 'now' && (
                      <svg class="card-icon-svg" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                      </svg>
                    )}
                  </span>
                  <span class="link-title">{link.title}</span>
                </span>
                <span class="link-arrow" aria-hidden="true">
                  →
                </span>
              </a>
              <p class="link-desc">{link.description}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Layout>

<style>
  .about-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .about-header {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .header-avatar-container {
    flex-shrink: 0;
  }

  .header-avatar {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% -13px;
    border: 2px solid var(--color-border);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .header-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .about-name {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .about-meta {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
  }

  .meta-separator {
    color: var(--color-border);
  }

  .about-intro {
    font-size: var(--font-size-lg);
    line-height: 1.7;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .bio-photo-card {
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: var(--color-border-subtle);
  }

  .bio-photo {
    width: 100%;
    height: auto;
    max-height: 500px;
    object-fit: cover;
    display: block;
  }

  .bio-photo-caption {
    padding: var(--space-xs) var(--space-md);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    font-style: italic;
  }

  .onward-section {
    margin-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-xl);
  }

  .onward-heading {
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-md) 0;
  }

  .onward-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-md);
  }

  .onward-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    background-color: var(--color-bg);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .onward-item:hover {
    border-color: var(--color-accent);
  }

  .onward-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }

  .onward-link:hover {
    color: var(--color-accent);
  }

  .link-title-wrapper {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .card-icon-svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .onward-link:hover .card-icon {
    color: var(--color-accent);
    transform: scale(1.1);
  }

  .link-arrow {
    transition: transform 0.15s ease;
  }

  .onward-link:hover .link-arrow {
    transform: translateX(3px);
  }

  .link-desc {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  @media (max-width: 480px) {
    .about-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }
  }
</style>
