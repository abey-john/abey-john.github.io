---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config';
import headshotImg from '../assets/photos/abey-headshot.png';
import bioPhoto from '../assets/photos/abey-about.png';

const aboutEntry = await getEntry('about', 'index');
const { Content } = aboutEntry ? await render(aboutEntry) : { Content: null };

const onwardLinks = [
  {
    href: '/development',
    title: 'Development',
    description: 'Some of my technical work.',
  },
  {
    href: '/travel',
    title: 'Travel',
    description: "I've got things to do and places to be.",
  },
  {
    href: '/music',
    title: 'Music',
    description: 'Put the headphones on.',
  },
  {
    href: '/now',
    title: 'Now',
    description: "What I'm currently up to.",
  },
];
---

<Layout
  title="About"
  description="Personal website of Abey John, a software engineer."
>
  <article class="about-page">
    <header class="about-header">
      <div class="header-avatar-container">
        <Image
          src={headshotImg}
          alt={siteConfig.name}
          width={160}
          class="header-avatar"
          loading="eager"
        />
      </div>
      <div class="header-info">
        <h1 class="about-name">{siteConfig.name}</h1>
        <p class="about-meta">
          <span>{siteConfig.role}</span>
          <span class="meta-separator">•</span>
          <span>{siteConfig.location}</span>
        </p>
      </div>
    </header>

    <div class="prose about-intro">
      {Content && <Content />}
    </div>

    <figure class="bio-photo-card">
      <Image
        src={bioPhoto}
        alt="Abey at the Matterhorn"
        class="bio-photo"
        loading="lazy"
      />
      <figcaption class="bio-photo-caption">
        The Matterhorn, Switzerland
      </figcaption>
    </figure>

    <section class="onward-section" aria-labelledby="onward-heading">
      <h2 id="onward-heading" class="onward-heading">Explore</h2>
      <ul class="onward-list">
        {
          onwardLinks.map((link) => (
            <li class="onward-item">
              <a href={link.href} class="onward-link">
                <span class="link-title">{link.title}</span>
                <span class="link-arrow" aria-hidden="true">
                  →
                </span>
              </a>
              <p class="link-desc">{link.description}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Layout>

<style>
  .about-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .about-header {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .header-avatar-container {
    flex-shrink: 0;
  }

  .header-avatar {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% -13px;
    border: 2px solid var(--color-border);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .header-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .about-name {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .about-meta {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
  }

  .meta-separator {
    color: var(--color-border);
  }

  .about-intro {
    font-size: var(--font-size-lg);
    line-height: 1.7;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .bio-photo-card {
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: var(--color-border-subtle);
  }

  .bio-photo {
    width: 100%;
    height: auto;
    max-height: 500px;
    object-fit: cover;
    display: block;
  }

  .bio-photo-caption {
    padding: var(--space-xs) var(--space-md);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    font-style: italic;
  }

  .onward-section {
    margin-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-xl);
  }

  .onward-heading {
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-md) 0;
  }

  .onward-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-md);
  }

  .onward-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    background-color: var(--color-bg);
  }

  .onward-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }

  .onward-link:hover {
    color: var(--color-accent);
  }

  .link-arrow {
    transition: transform 0.15s ease;
  }

  .onward-link:hover .link-arrow {
    transform: translateX(3px);
  }

  .link-desc {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  @media (max-width: 480px) {
    .about-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }
  }
</style>
