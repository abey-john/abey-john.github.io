---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import MediaImage from '../components/MediaImage.astro';

const allLaunches = await getCollection('launches');

const professionalItems = allLaunches
  .filter((item) => item.data.category === 'professional')
  .sort((a, b) => a.data.order - b.data.order);

const personalItems = allLaunches
  .filter((item) => item.data.category === 'personal')
  .sort((a, b) => a.data.order - b.data.order);

function formatDisplayUrl(url: string) {
  return url.replace(/^https?:\/\//, '').replace(/\/$/, '');
}
---

<Layout
  title="Development"
  description="Public software launches and personal engineering projects."
>
  <article class="dev-page">
    <header class="page-header">
      <h1 class="page-title">Development</h1>
      <p class="framing-line">
        A selection of systems I've contributed to professionally and personal
        pet projects I've built on the side.
      </p>
    </header>

    <div class="sections-container">
      <section class="dev-section" aria-labelledby="heading-professional">
        <header class="section-header">
          <h2 id="heading-professional" class="section-title">Professional</h2>
          <p class="section-subtitle">
            Some of the things I've built professionally as a software engineer.
          </p>
        </header>

        <ul class="items-list">
          {
            professionalItems.map((item) =>
              item.data.image ? (
                <li class="item-card item-card-featured">
                  <a
                    href={item.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="featured-media"
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    <MediaImage
                      src={item.data.image}
                      alt={item.data.title}
                      width={880}
                      aspectRatio="1021 / 870"
                      quality={95}
                      class="featured-media-inner"
                      imageClass="featured-image"
                      loading="eager"
                    />
                  </a>
                  <div class="featured-content">
                    <div class="item-header">
                      <h3 class="item-title">
                        <a
                          href={item.data.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="item-link"
                        >
                          <span>{item.data.title}</span>
                          <span class="external-icon" aria-hidden="true">
                            &nearr;
                          </span>
                        </a>
                      </h3>
                    </div>
                    <p class="item-role">{item.data.role}</p>
                    <div class="item-url-wrapper">
                      <a
                        href={item.data.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="item-url"
                      >
                        {formatDisplayUrl(item.data.url)}
                      </a>
                    </div>
                  </div>
                </li>
              ) : (
                <li class="item-card">
                  <div class="item-header">
                    <h3 class="item-title">
                      <a
                        href={item.data.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="item-link"
                      >
                        <span>{item.data.title}</span>
                        <span class="external-icon" aria-hidden="true">
                          &nearr;
                        </span>
                      </a>
                    </h3>
                  </div>
                  <p class="item-role">{item.data.role}</p>
                  <div class="item-url-wrapper">
                    <a
                      href={item.data.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="item-url"
                    >
                      {formatDisplayUrl(item.data.url)}
                    </a>
                  </div>
                </li>
              )
            )
          }
        </ul>
      </section>

      <section class="dev-section" aria-labelledby="heading-personal">
        <header class="section-header">
          <h2 id="heading-personal" class="section-title">Personal</h2>
          <p class="section-subtitle">
            Solo work for a bit of fun and experimentation.
          </p>
        </header>

        <ul class="items-list">
          {
            personalItems.map((item) =>
              item.data.image ? (
                <li class="item-card item-card-featured item-card-featured-reverse">
                  <div class="featured-content">
                    <div class="item-header">
                      <h3 class="item-title">
                        <a
                          href={item.data.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="item-link"
                        >
                          <span>{item.data.title}</span>
                          <span class="external-icon" aria-hidden="true">
                            &nearr;
                          </span>
                        </a>
                      </h3>
                    </div>
                    <p class="item-role">{item.data.role}</p>
                    <div class="item-url-wrapper">
                      <a
                        href={item.data.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="item-url"
                      >
                        {formatDisplayUrl(item.data.url)}
                      </a>
                    </div>
                  </div>
                  <a
                    href={item.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="featured-media featured-media-icon"
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    {(() => {
                      const isGithubIcon =
                        item.data.id === 'personal-website' ||
                        item.data.title.toLowerCase().includes('github');
                      return (
                        <MediaImage
                          src={item.data.image}
                          alt={item.data.title}
                          width={280}
                          height={280}
                          quality={98}
                          class="github-logo-wrapper"
                          imageClass={`featured-image ${isGithubIcon ? 'github-logo' : ''}`}
                          loading="lazy"
                        />
                      );
                    })()}
                  </a>
                </li>
              ) : (
                <li class="item-card">
                  <div class="item-header">
                    <h3 class="item-title">
                      <a
                        href={item.data.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="item-link"
                      >
                        <span>{item.data.title}</span>
                        <span class="external-icon" aria-hidden="true">
                          &nearr;
                        </span>
                      </a>
                    </h3>
                  </div>
                  <p class="item-role">{item.data.role}</p>
                  <div class="item-url-wrapper">
                    <a
                      href={item.data.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="item-url"
                    >
                      {formatDisplayUrl(item.data.url)}
                    </a>
                  </div>
                </li>
              )
            )
          }
        </ul>
      </section>
    </div>
  </article>
</Layout>

<style>
  .dev-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-lg);
  }

  .page-title {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .framing-line {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  .sections-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .dev-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .section-title {
    font-size: var(--font-size-xl);
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .section-subtitle {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  .items-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .item-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    background-color: var(--color-bg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    transition: border-color 0.15s ease;
  }

  .item-card:hover {
    border-color: var(--color-accent);
  }

  .item-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .item-title {
    font-size: var(--font-size-lg);
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }

  .item-link {
    text-decoration: none;
    color: var(--color-text);
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .item-link:hover {
    color: var(--color-accent);
  }

  .external-icon {
    font-size: 0.9em;
    opacity: 0.7;
    transition: transform 0.15s ease;
  }

  .item-link:hover .external-icon {
    transform: translate(2px, -2px);
    opacity: 1;
  }

  .item-role {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    margin: var(--space-xs) 0;
    line-height: 1.5;
  }

  .item-url-wrapper {
    margin-top: var(--space-xs);
  }

  .item-url {
    font-size: var(--font-size-sm);
    color: var(--color-accent);
    font-family: var(--font-mono);
    word-break: break-all;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .item-url:hover {
    color: var(--color-accent-hover);
  }

  .item-card-featured {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-lg);
    align-items: center;
  }

  .featured-media {
    display: block;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: var(--color-border-subtle);
    aspect-ratio: 1021 / 870;
  }

  :global(.featured-media-inner) {
    width: 100%;
    height: 100%;
    background-color: transparent;
  }

  .featured-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.2s ease;
  }

  .item-card-featured:hover .featured-image {
    transform: scale(1.02);
  }

  .featured-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .featured-media-icon {
    width: 140px;
    height: 140px;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
  }

  .featured-media-icon :global(.github-logo-wrapper) {
    width: 100%;
    height: 100%;
    background-color: transparent !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .featured-media-icon :global(.featured-image) {
    object-fit: contain;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    margin: auto;
    display: block;
  }

  .item-card-featured-reverse {
    grid-template-columns: 1fr 140px;
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme="light"])) :global(.github-logo) {
      filter: invert(1);
    }
  }

  :global(html[data-theme="dark"]) :global(.github-logo) {
    filter: invert(1);
  }

  @media (max-width: 640px) {
    .item-card-featured {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .item-card-featured-reverse .featured-media-icon {
      order: -1;
    }

    .featured-media-icon {
      width: 140px;
      height: 140px;
      max-width: 140px;
    }
  }
</style>
