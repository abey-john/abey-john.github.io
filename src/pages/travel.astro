---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TravelMap from '../components/travel/TravelMap.astro';
import PlacesDirectory from '../components/travel/PlacesDirectory.astro';

const places = await getCollection('places');
const trips = await getCollection('trips');
---

<Layout
  title="Travel"
  description="Interactive map of places visited across cities, national parks, and public lands."
  wide={true}
>
  <article class="travel-page">
    <header class="travel-header">
      <h1 class="travel-title">Travel</h1>
      <p class="travel-framing">
        A map of some of the cool places I've been to.
      </p>
    </header>

    <section class="map-section" aria-label="Interactive travel map">
      <TravelMap places={places} trips={trips} />
    </section>

    <PlacesDirectory places={places} />
  </article>
</Layout>

<style>
  .travel-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .travel-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-lg);
  }

  .travel-title {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .travel-framing {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .map-section {
    width: 100%;
  }
</style>
