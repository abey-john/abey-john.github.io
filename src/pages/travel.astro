---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TravelMap from '../components/TravelMap.astro';

const places = await getCollection('places');

const sortedPlaces = places
  .slice()
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Layout
  title="Travel"
  description="Interactive map of places visited across cities, national parks, and public lands."
  wide={true}
>
  <article class="travel-page">
    <header class="travel-header">
      <h1 class="travel-title">Travel</h1>
      <p class="travel-framing">
        A map of some of the cool places I've been to.
      </p>
    </header>

    <section class="map-section" aria-label="Interactive travel map">
      <TravelMap places={places} />
    </section>

    <section
      class="places-fallback-section"
      aria-label="Directory of visited places"
    >
      <details class="places-details">
        <summary class="places-summary">
          <span class="summary-title"
            >View full list of places <span id="summary-count">({sortedPlaces.length})</span></span
          >
          <span class="summary-tag">Text list</span>
        </summary>
        <div class="places-grid">
          {
            sortedPlaces.map((place) => (
              <div class="place-card" data-type={place.data.type}>
                <div class="place-header">
                  <span
                    class={`type-pill ${
                      place.data.type === 'park'
                        ? 'pill-park'
                        : place.data.type === 'landmark'
                          ? 'pill-landmark'
                          : 'pill-city'
                    }`}
                  >
                    {place.data.type === 'park'
                      ? 'Park'
                      : place.data.type === 'landmark'
                        ? 'Landmark'
                        : 'City'}
                  </span>
                  <h2 class="place-name">{place.data.name}</h2>
                </div>
                {place.data.blurb && (
                  <p class="place-blurb" set:html={place.data.blurb} />
                )}
              </div>
            ))
          }
        </div>
      </details>
    </section>
  </article>
</Layout>

<style>
  .travel-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .travel-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-lg);
  }

  .travel-title {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .travel-framing {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .map-section {
    width: 100%;
  }

  .places-fallback-section {
    margin-top: var(--space-xs);
  }

  .places-details {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    background-color: var(--color-bg);
  }

  .places-summary {
    cursor: pointer;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
    color: var(--color-text);
  }

  .places-summary:hover {
    color: var(--color-accent);
  }

  .summary-tag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  .places-grid {
    margin-top: var(--space-lg);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .place-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-md);
    background-color: var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .place-header {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .type-pill {
    font-size: 0.6875rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .pill-park {
    background-color: rgba(5, 150, 105, 0.15);
    color: #059669;
  }

  .pill-city {
    background-color: rgba(37, 99, 235, 0.15);
    color: #2563eb;
  }

  .pill-landmark {
    background-color: rgba(217, 119, 6, 0.15);
    color: #d97706;
  }

  .place-name {
    font-size: var(--font-size-base);
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }

  .place-blurb {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.4;
  }
</style>
