---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TravelMap from '../components/travel/TravelMap.astro';
import PlacesDirectory from '../components/travel/PlacesDirectory.astro';

const places = await getCollection('places');
const trips = await getCollection('trips');
---

<Layout
  title="Travel"
  description="Interactive map of places visited across cities, national parks, and public lands."
  fullBleed={true}
>
  <Fragment slot="head">
    <link
      rel="preconnect"
      href="https://elevation-tiles-prod.s3.amazonaws.com"
      crossorigin
    />
    <link
      rel="dns-prefetch"
      href="https://elevation-tiles-prod.s3.amazonaws.com"
    />
  </Fragment>
  <article class="travel-page">
    <h1 class="sr-only">Travel</h1>

    <section class="map-section" aria-label="Interactive travel map">
      <TravelMap places={places} trips={trips} />
    </section>

    <div
      class="container-wide travel-directory-wrap"
      id="places-directory-section"
    >
      <PlacesDirectory places={places} />
    </div>
  </article>
</Layout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .travel-page {
    display: flex;
    flex-direction: column;
  }

  .map-section {
    width: 100%;
  }

  .travel-directory-wrap {
    margin-top: var(--space-xl);
  }
</style>
