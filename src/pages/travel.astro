---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TravelMap from '../components/TravelMap.astro';

const places = await getCollection('places');
const trips = await getCollection('trips');

const sortedPlaces = places
  .slice()
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Layout
  title="Travel"
  description="Interactive map of places visited across cities, national parks, and public lands."
  wide={true}
>
  <article class="travel-page">
    <header class="travel-header">
      <h1 class="travel-title">Travel</h1>
      <p class="travel-framing">
        A map of some of the cool places I've been to.
      </p>
    </header>

    <section class="map-section" aria-label="Interactive travel map">
      <TravelMap places={places} trips={trips} />
    </section>

    <section
      class="places-fallback-section"
      aria-label="Directory of visited places"
    >
      <details class="places-details">
        <summary class="places-summary">
          <span class="summary-title"
            >View full list of places <span id="summary-count">({sortedPlaces.length})</span></span
          >
          <span class="summary-tag">Text list</span>
        </summary>
        <div class="places-grid">
          {
            sortedPlaces.map((place) => (
              <div
                class="place-card"
                role="button"
                tabindex="0"
                data-id={place.data.id}
                data-name={place.data.name}
                data-type={place.data.type}
                data-lat={place.data.lat}
                data-lng={place.data.lng}
                aria-label={`View ${place.data.name} on map`}
              >
                <div class="place-header">
                  <span
                    class={`type-pill ${
                      place.data.type === 'park'
                        ? 'pill-park'
                        : place.data.type === 'landmark'
                          ? 'pill-landmark'
                          : 'pill-city'
                    }`}
                  >
                    {place.data.type === 'park'
                      ? 'Park'
                      : place.data.type === 'landmark'
                        ? 'Landmark'
                        : 'City'}
                  </span>
                  <h2 class="place-name">{place.data.name}</h2>
                  <span class="fly-indicator" aria-hidden="true" title="View on map">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path>
                      <circle cx="12" cy="10" r="2.5"></circle>
                    </svg>
                  </span>
                </div>
                {place.data.blurb && (
                  <p class="place-blurb" set:html={place.data.blurb} />
                )}
              </div>
            ))
          }
        </div>
      </details>
    </section>
  </article>
</Layout>

<style>
  .travel-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .travel-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-lg);
  }

  .travel-title {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .travel-framing {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .map-section {
    width: 100%;
  }

  .places-fallback-section {
    margin-top: var(--space-xs);
  }

  .places-details {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    background-color: var(--color-bg);
  }

  .places-summary {
    cursor: pointer;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
    color: var(--color-text);
  }

  .places-summary:hover {
    color: var(--color-accent);
  }

  .summary-tag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  .places-grid {
    margin-top: var(--space-md);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .place-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
    min-height: 48px;
    background-color: var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    justify-content: center;
    cursor: pointer;
    text-align: left;
    transition:
      transform 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.18s ease,
      background-color 0.18s ease,
      box-shadow 0.18s ease;
    user-select: none;
  }

  .place-card:hover {
    border-color: var(--color-accent);
    background-color: var(--color-bg);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }

  .place-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .place-card:active {
    transform: translateY(0);
  }

  .place-header {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
  }

  .fly-indicator {
    margin-left: auto;
    color: var(--color-text-muted);
    opacity: 0.35;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2px;
    border-radius: 4px;
    flex-shrink: 0;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      color 0.18s ease;
  }

  .place-card:hover .fly-indicator {
    opacity: 1;
    color: var(--color-accent);
    transform: scale(1.18);
  }

  .type-pill {
    font-size: 0.6875rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 2px 7px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .pill-park {
    background-color: rgba(5, 150, 105, 0.15);
    color: #059669;
  }

  .pill-city {
    background-color: rgba(37, 99, 235, 0.15);
    color: #2563eb;
  }

  .pill-landmark {
    background-color: rgba(217, 119, 6, 0.15);
    color: #d97706;
  }

  .place-name {
    font-size: 0.9375rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .place-blurb {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin: var(--space-xs) 0 0 0;
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .places-grid {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .place-card {
      padding: 9px 12px;
      min-height: 44px;
    }
  }
</style>
