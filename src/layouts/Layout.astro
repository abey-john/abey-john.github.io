---
import { ClientRouter } from 'astro:transitions';
import { getEntry } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteConfig } from '../config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  schema?: Record<string, any>;
}

const siteConfig = await getSiteConfig();
const aboutEntry = await getEntry('about', 'index');
const { title, description, wide = false, schema } = Astro.props;
const pageTitle = title
  ? `${title} — ${siteConfig.name || 'Abey John'}`
  : siteConfig.name || 'Abey John';
const metaDescription = description || siteConfig.description;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || 'https://abey-john.github.io'
);

const siteOrigin = (
  Astro.site ? new URL(Astro.site) : new URL('https://abey-john.github.io')
).origin;
const avatarSrc = aboutEntry?.data?.avatar || aboutEntry?.data?.photo;
const avatarUrl = avatarSrc ? new URL(avatarSrc, siteOrigin).href : undefined;
const ogImageURL = new URL('/og-image.jpg', siteOrigin).href;
const ogImageAlt = `${siteConfig.name || 'Abey John'}`;

const locationParts = siteConfig.location
  ? siteConfig.location.split(',').map((s) => s.trim())
  : [];
const addressObject =
  locationParts.length > 0
    ? {
        '@type': 'PostalAddress',
        addressLocality: locationParts[0],
        ...(locationParts[1] ? { addressRegion: locationParts[1] } : {}),
      }
    : undefined;

const sameAs = [siteConfig.github, siteConfig.linkedin].filter(Boolean);

const isAws =
  siteConfig.role?.toLowerCase().includes('aws') ||
  siteConfig.role?.toLowerCase().includes('amazon');

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteOrigin}/#person`,
  name: siteConfig.name || 'Abey John',
  url: `${siteOrigin}/`,
  ...(avatarUrl ? { image: avatarUrl } : {}),
  ...(siteConfig.role ? { jobTitle: siteConfig.role } : {}),
  ...(isAws
    ? {
        worksFor: {
          '@type': 'Organization',
          name: 'Amazon Web Services',
          alternateName: 'AWS',
          url: 'https://aws.amazon.com',
        },
      }
    : {}),
  ...(addressObject ? { address: addressObject } : {}),
  ...(sameAs.length > 0 ? { sameAs } : {}),
  ...(siteConfig.email ? { email: `mailto:${siteConfig.email}` } : {}),
  ...(metaDescription ? { description: metaDescription } : {}),
  knowsAbout: [
    'Software Engineering',
    'Distributed Systems',
    'Cloud Computing',
  ],
};

const jsonLd = schema || personSchema;
---

<!doctype html>
<html lang="en">
  <head>
    <ClientRouter />
    {
      import.meta.env.PROD && (
        <script
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id="f59f07a8-f491-49d2-90c9-a660a68dcc22"
        />
      )
    }
    <script is:inline>
      function applyTheme() {
        try {
          const theme = localStorage.getItem('theme');
          if (theme === 'dark' || theme === 'light') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (e) {}
      }
      applyTheme();
      document.addEventListener('astro:before-swap', function (e) {
        var currentTheme = document.documentElement.getAttribute('data-theme');
        if (currentTheme) {
          e.newDocument.documentElement.setAttribute(
            'data-theme',
            currentTheme
          );
        }
      });
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    {metaDescription && <meta name="description" content={metaDescription} />}

    <meta property="og:title" content={pageTitle} />
    {
      metaDescription && (
        <meta property="og:description" content={metaDescription} />
      )
    }
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name || 'Abey John'} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    {
      metaDescription && (
        <meta name="twitter:description" content={metaDescription} />
      )
    }
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <title>{pageTitle}</title>
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd, null, 2)}
    />
  </head>
  <body>
    <div class="site-wrapper">
      <a href="#main-content" class="skip-link">Skip to content</a>
      <Header />
      <main
        id="main-content"
        class:list={['main-content', wide ? 'container-wide' : 'container']}
      >
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
