---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteConfig } from '../config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const siteConfig = await getSiteConfig();
const { title, description, wide = false } = Astro.props;
const pageTitle = title ? `${title} — ${siteConfig.name}` : siteConfig.name;
const defaultDescription = siteConfig.description || `${siteConfig.name} — software engineer. Personal website featuring engineering projects, travel, music, and current focus.`;
const metaDescription = description || defaultDescription;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://abey-john.github.io');
---

<!doctype html>
<html lang="en">
  <head>
    <ClientRouter />
    <script is:inline>
      function applyTheme() {
        try {
          const theme = localStorage.getItem('theme');
          if (theme === 'dark' || theme === 'light') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (e) {}
      }
      applyTheme();
      document.addEventListener('astro:before-swap', function (e) {
        var currentTheme = document.documentElement.getAttribute('data-theme');
        if (currentTheme) {
          e.newDocument.documentElement.setAttribute('data-theme', currentTheme);
        }
      });
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metaDescription} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />

    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-wrapper">
      <a href="#main-content" class="skip-link">Skip to content</a>
      <Header />
      <main id="main-content" class:list={['main-content', wide ? 'container-wide' : 'container']}>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
