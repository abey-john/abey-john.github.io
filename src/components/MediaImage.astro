---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  width?: number;
  height?: number;
  aspectRatio?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  alt,
  width,
  height,
  aspectRatio,
  class: className,
  loading = 'lazy',
} = Astro.props;

const isMetadata = typeof src === 'object' && src !== null && 'src' in src;
const resolvedWidth = width ?? (isMetadata ? (src as ImageMetadata).width : undefined);
const resolvedHeight = height ?? (isMetadata ? (src as ImageMetadata).height : undefined);
---

<div class:list={['image-wrapper', className]} style={aspectRatio ? `aspect-ratio: ${aspectRatio};` : undefined}>
  {
    isMetadata ? (
      <Image
        src={src as ImageMetadata}
        alt={alt}
        width={resolvedWidth}
        height={resolvedHeight}
        loading={loading}
        class="media-image"
      />
    ) : (
      <img
        src={src as string}
        alt={alt}
        width={resolvedWidth}
        height={resolvedHeight}
        loading={loading}
        class="media-image"
      />
    )
  }
</div>

<style>
  .image-wrapper {
    display: block;
    position: relative;
    overflow: hidden;
    background-color: var(--color-border-subtle);
  }

  .media-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
