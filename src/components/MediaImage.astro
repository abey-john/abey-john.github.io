---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getNotionImageMetadata } from '../utils/images';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  width?: number;
  height?: number;
  aspectRatio?: string;
  class?: string;
  imageClass?: string;
  loading?: 'lazy' | 'eager';
  widths?: number[];
  sizes?: string;
  densities?: (number | `${number}x`)[];
  quality?: number | 'low' | 'mid' | 'high' | 'max';
  fit?: 'cover' | 'contain' | 'fill' | 'none' | 'scale-down';
  style?: string;
}

const {
  src,
  alt,
  width,
  height,
  aspectRatio,
  class: className,
  imageClass,
  loading = 'lazy',
  widths,
  sizes,
  densities,
  quality = 92,
  fit,
  style: inlineStyle
} = Astro.props;

const imageMetadata = await getNotionImageMetadata(src);
const imageProps = widths
  ? { widths, sizes }
  : { densities: densities ?? [1, 2] };

const isContain = fit === 'contain';

const imageStyle = [
  fit ? `object-fit: ${fit};` : undefined,
  isContain ? 'width: auto; height: auto; max-width: 100%;' : undefined,
  inlineStyle
]
  .filter(Boolean)
  .join(' ');
---

<div
  class:list={['image-wrapper', { 'fit-contain': isContain }, className]}
  style={aspectRatio ? `aspect-ratio: ${aspectRatio};` : undefined}
>
  {imageMetadata ? (
    <Image
      src={imageMetadata}
      alt={alt}
      width={width ?? imageMetadata.width}
      height={
        height ??
        (width
          ? Math.round(width / (imageMetadata.width / imageMetadata.height))
          : imageMetadata.height)
      }
      quality={quality}
      loading={loading}
      {...imageProps}
      class:list={['media-image', { 'fit-contain': isContain }, imageClass]}
      style={imageStyle || undefined}
    />
  ) : (
    <img
      src={src as string}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      class:list={['media-image', { 'fit-contain': isContain }, imageClass]}
      style={imageStyle || undefined}
    />
  )}
</div>

<style>
  .image-wrapper {
    display: block;
    position: relative;
    overflow: hidden;
    background-color: var(--color-border-subtle);
  }

  .image-wrapper.fit-contain {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
  }

  .media-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-image.fit-contain {
    width: auto;
    height: auto;
    max-width: 100%;
    object-fit: contain;
    margin: 0 auto;
  }
</style>
