---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getNotionImageMetadata } from '../utils/images';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  width?: number;
  height?: number;
  aspectRatio?: string;
  class?: string;
  imageClass?: string;
  loading?: 'lazy' | 'eager';
  widths?: number[];
  sizes?: string;
  densities?: (number | `${number}x`)[];
  quality?: number | 'low' | 'mid' | 'high' | 'max';
}

const {
  src,
  alt,
  width,
  height,
  aspectRatio,
  class: className,
  imageClass,
  loading = 'lazy',
  widths,
  sizes,
  densities,
  quality = 92,
} = Astro.props;

const imageMetadata = await getNotionImageMetadata(src);
const imageProps = widths
  ? { widths, sizes }
  : { densities: densities ?? [1, 2] };
---

<div
  class:list={['image-wrapper', className]}
  style={aspectRatio ? `aspect-ratio: ${aspectRatio};` : undefined}
>
  {
    imageMetadata ? (
      <Image
        src={imageMetadata}
        alt={alt}
        width={width ?? imageMetadata.width}
        height={height ?? (width ? Math.round(width / (imageMetadata.width / imageMetadata.height)) : imageMetadata.height)}
        quality={quality}
        loading={loading}
        {...imageProps}
        class:list={['media-image', imageClass]}
      />
    ) : (
      <img
        src={src as string}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        class:list={['media-image', imageClass]}
      />
    )
  }
</div>

<style>
  .image-wrapper {
    display: block;
    position: relative;
    overflow: hidden;
    background-color: var(--color-border-subtle);
  }

  .media-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
