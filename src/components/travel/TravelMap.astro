        </svg>
      </span>
      <span class="pill-label">Landmarks</span>
      <span class="pill-count">{landmarkCount}</span>
    </button>

    {tripsData.length > 0 && (
      <>
        <div
          class="filter-divider"
          role="separator"
          aria-orientation="vertical"
