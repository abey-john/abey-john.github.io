---
import type { CollectionEntry } from 'astro:content';
import { getTripTheme } from '../../utils/travelColors';
import './TravelMap.css';

interface Props {
  places: CollectionEntry<'places'>[];
  trips?: CollectionEntry<'trips'>[];
}

const { places, trips = [] } = Astro.props;

const parkCount = places.filter((p) => p.data.type === 'park').length;
const cityCount = places.filter((p) => p.data.type === 'city').length;
const landmarkCount = places.filter((p) => p.data.type === 'landmark').length;
const totalCount = parkCount + cityCount + landmarkCount;

const parseTripDate = (dateStr?: string): number => {
  if (!dateStr) return 0;
  const parsed = Date.parse(dateStr);
  if (!isNaN(parsed)) return parsed;
  const parts = dateStr.trim().split(/\s+/);
  if (parts.length === 2) {
    const timestamp = Date.parse(`${parts[0]} 1, ${parts[1]}`);
    if (!isNaN(timestamp)) return timestamp;
  }
  return 0;
};

// Sort trips reverse-chronologically (newest first)
const sortedTrips = trips.slice().sort((a, b) => {
  const timeA = parseTripDate(a.data.date);
  const timeB = parseTripDate(b.data.date);
  return timeB - timeA;
});

const tripsData = sortedTrips.map((t) => t.data);

const placesData = places.map((p) => {
  const matchedTrips: {
    tripId: string;
    tripName: string;
    color: string;
    mode: string;
    stopIndices: number[];
    totalStops: number;
    summary?: string;
  }[] = [];

  for (const t of sortedTrips) {
    const indices: number[] = [];
    t.data.stops.forEach((stop, idx) => {
      const matchById = Boolean(stop.placeId && stop.placeId === p.data.id);
      const matchByCoords =
        Math.abs(stop.lat - p.data.lat) < 0.001 &&
        Math.abs(stop.lng - p.data.lng) < 0.001;
      const matchByName =
        stop.name.toLowerCase().trim() === p.data.name.toLowerCase().trim();

      if (matchById || matchByCoords || matchByName) {
        indices.push(idx + 1);
      }
    });

    if (indices.length > 0) {
      matchedTrips.push({
        tripId: t.data.id,
        tripName: t.data.name,
        color: t.data.color,
        mode: t.data.mode || 'drive',
        stopIndices: indices,
        totalStops: t.data.stops.length,
        summary: t.data.summary
      });
    }
  }

  return {
    id: p.data.id,
    name: p.data.name,
    type: p.data.type,
    lat: p.data.lat,
    lng: p.data.lng,
    country: p.data.country,
    state: p.data.state,
    blurb: p.data.blurb,
    photo: p.data.photo,
    link: p.data.link,
    trips: matchedTrips
  };
});
---

<div class="travel-map-container">
  <div
    class="map-filter-bar"
    role="group"
    aria-label="Filter places by category and view road trip routes"
  >
    <button
      type="button"
      class="filter-pill active"
      data-category="all"
      aria-pressed="true"
      id="filter-pill-all"
    >
      <span class="pill-icon all-icon" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          width="13"
          height="13"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
        </svg>
      </span>
      <span class="pill-label">All</span>
      <span class="pill-count">{totalCount}</span>
    </button>
    <button
      type="button"
      class="filter-pill filter-park"
      data-category="park"
      aria-pressed="false"
      id="filter-pill-park"
    >
