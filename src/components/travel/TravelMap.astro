            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <button
          type="button"
          class="stepper-btn stepper-next"
          id="stepper-next"
          aria-label="Next stop (Right Arrow)"
