---
interface Props {
  username?: string;
  limit?: number;
  class?: string;
}

const { username = 'itseebo', limit = 5, class: className = '' } = Astro.props;
---

<aside
  class:list={['music-ticker-wrapper', className]}
  data-music-ticker
  data-username={username}
  data-limit={limit}
  aria-label="Today's top listened tracks ticker"
>
  <div class="music-ticker" data-ticker-container>
    <!-- Pinned Leading Badge -->
    <div class="ticker-badge" aria-label="Today's Top 5">
      <span class="live-dot" aria-hidden="true"></span>
      <span class="badge-text" data-badge-text>
        Today's Top 5
      </span>
    </div>

    <!-- Scrolling Marquee Viewport -->
    <div class="ticker-viewport">
      <!-- Loading Skeleton -->
      <div class="ticker-skeleton" data-ticker-skeleton aria-hidden="true">
        <div class="skeleton-item">
          <div class="skeleton-thumb"></div>
          <div class="skeleton-text"></div>
        </div>
        <div class="skeleton-item hide-sm">
          <div class="skeleton-thumb"></div>
          <div class="skeleton-text"></div>
        </div>
        <div class="skeleton-item hide-md">
          <div class="skeleton-thumb"></div>
          <div class="skeleton-text"></div>
        </div>
      </div>

      <!-- Live continuous marquee (dynamically populated) -->
      <div
        class="ticker-marquee"
        data-ticker-marquee
        style="display: none;"
        tabindex="0"
        role="region"
        aria-label="Continuous list of today's top tracks. Click any track to play a 30-second audio preview."
      >
        <div class="ticker-track" data-ticker-track-primary></div>
        <div
          class="ticker-track aria-duplicate"
          data-ticker-track-secondary
          aria-hidden="true"
        ></div>
      </div>
    </div>
  </div>
</aside>

<script>
  let activeAbortController: AbortController | null = null;
  let activeAudio: HTMLAudioElement | null = null;
  let activeTrackId: string | null = null;

  interface StatsFmTrackItem {
    position: number;
    streams: number;
    track?: {
      id?: number;
      name?: string;
      artists?: Array<{ name: string }>;
      albums?: Array<{ image?: string; name?: string }>;
      appleMusicPreview?: string | null;
      spotifyPreview?: string | null;
      externalIds?: {
        spotify?: string[];
      };
    };
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function stopTickerAudio() {
    if (activeAudio) {
      activeAudio.pause();
      activeAudio.removeAttribute('src');
      activeAudio.load();
      activeAudio = null;
    }
    activeTrackId = null;

    document
      .querySelectorAll<HTMLElement>(
        '.ticker-pill.is-playing, .ticker-pill.is-loading, .ticker-pill.is-active, .ticker-pill.is-paused'
      )
      .forEach((el) => {
        el.classList.remove(
          'is-playing',
          'is-loading',
          'is-active',
          'is-paused'
        );
        el.setAttribute('aria-pressed', 'false');
        const ring = el.querySelector<SVGGeometryElement>('.ring-fill');
        if (ring) ring.style.strokeDashoffset = '100';
      });
  }

  async function resolveAudioPreview(
    title: string,
    artist: string,
    providedUrl?: string | null
  ): Promise<string | null> {
    if (providedUrl) return providedUrl;

    try {
      const q = `${title} ${artist}`.trim();
      const res = await fetch(
        `https://itunes.apple.com/search?term=${encodeURIComponent(q)}&entity=song&limit=5`
      );
      if (res.ok) {
        const data = await res.json();
        const songs = (data.results || []).filter((t: any) => t.previewUrl);
        if (songs.length > 0) {
          return songs[0].previewUrl;
        }
      }
    } catch {}

    return null;
  }

  async function handlePillClick(pill: HTMLElement) {
    const trackId = pill.dataset.trackId || '';
    const title = pill.dataset.title || 'Unknown Track';
    const artist = pill.dataset.artist || 'Unknown Artist';
    const rawPreviewUrl = pill.dataset.previewUrl || '';

    // Immediately release mouse focus so the marquee does not stay locked
    pill.blur();

    // If clicking currently playing track -> pause/resume
    if (activeTrackId === trackId && activeAudio) {
      if (activeAudio.paused) {
        try {
          await activeAudio.play();
          syncPillPlayingState(trackId, true);
        } catch (err) {
          console.warn('Resume error:', err);
        }
      } else {
        activeAudio.pause();
        syncPillPlayingState(trackId, false);
      }
      return;
    }

    // Stop current ticker audio & notify other audio players (spotlight, vinyl) to pause
    stopTickerAudio();
    window.dispatchEvent(
      new CustomEvent('music:stop-other-audio', {
        detail: { source: 'music-ticker' }
      })
    );

    activeTrackId = trackId;
    syncPillActiveState(trackId, true);
    syncPillLoadingState(trackId, true);

    const previewUrl = await resolveAudioPreview(title, artist, rawPreviewUrl);
    syncPillLoadingState(trackId, false);

    if (!previewUrl || activeTrackId !== trackId) {
      stopTickerAudio();
      return;
    }

    const audio = new Audio(previewUrl);
    activeAudio = audio;
    const MAX_PREVIEW_DURATION = 30;

    audio.addEventListener('timeupdate', () => {
      if (activeTrackId !== trackId) return;
      const current = audio.currentTime || 0;

      if (current >= MAX_PREVIEW_DURATION) {
        stopTickerAudio();
        return;
      }

      // Smooth fadeout in last 1.5s
      if (current >= MAX_PREVIEW_DURATION - 1.5) {
        try {
          audio.volume = Math.max(
            0,
            Math.min(1, (MAX_PREVIEW_DURATION - current) / 1.5)
          );
        } catch {}
      } else if (audio.volume < 1) {
        try {
          audio.volume = 1;
        } catch {}
      }

      const pct = Math.min(
        100,
        Math.max(0, (current / MAX_PREVIEW_DURATION) * 100)
      );

      document
        .querySelectorAll<SVGGeometryElement>(
          `.ticker-pill[data-track-id="${CSS.escape(trackId)}"] .ring-fill`
        )
        .forEach((ring) => {
          ring.style.strokeDashoffset = `${100 - pct}`;
        });
    });

    audio.addEventListener('ended', () => {
      if (activeTrackId === trackId) {
        stopTickerAudio();
      }
    });

    audio.addEventListener('pause', () => {
      if (activeTrackId === trackId && !audio.ended) {
        syncPillPlayingState(trackId, false);
      }
    });

    audio.addEventListener('play', () => {
      if (activeTrackId === trackId) {
        syncPillPlayingState(trackId, true);
      }
    });

    audio.addEventListener('error', () => {
      if (activeTrackId === trackId) {
        console.warn('Ticker audio error on', title);
        stopTickerAudio();
      }
    });

    try {
      await audio.play();
      syncPillPlayingState(trackId, true);
    } catch (err: any) {
      if (err.name !== 'AbortError') {
        console.warn('Playback error:', err);
        stopTickerAudio();
      }
    }
  }

  function syncPillActiveState(trackId: string, isActive: boolean) {
    document
      .querySelectorAll<HTMLElement>(
        `.ticker-pill[data-track-id="${CSS.escape(trackId)}"]`
      )
      .forEach((el) => {
        el.classList.toggle('is-active', isActive);
      });
  }

  function syncPillLoadingState(trackId: string, isLoading: boolean) {
    document
      .querySelectorAll<HTMLElement>(
        `.ticker-pill[data-track-id="${CSS.escape(trackId)}"]`
      )
      .forEach((el) => {
        el.classList.toggle('is-loading', isLoading);
      });
  }

  function syncPillPlayingState(trackId: string, isPlaying: boolean) {
    document
      .querySelectorAll<HTMLElement>(
        `.ticker-pill[data-track-id="${CSS.escape(trackId)}"]`
      )
      .forEach((el) => {
        el.classList.toggle('is-playing', isPlaying);
        el.classList.toggle('is-paused', !isPlaying);
        el.setAttribute('aria-pressed', isPlaying ? 'true' : 'false');
      });
  }

  function renderTrackNodes(
    items: StatsFmTrackItem[],
    isAriaClone = false
  ): string {
    if (!items || items.length === 0) return '';

    return items
      .map((item) => {
        const title = item.track?.name || 'Unknown Track';
        const artist =
          item.track?.artists?.map((a) => a.name).join(', ') ||
          'Unknown Artist';
        const image =
          item.track?.albums?.[0]?.image ||
          '/assets/covers/placeholder-album.svg';
        const trackId = String(item.track?.id || `${title}-${artist}`);
        const previewUrl =
          item.track?.appleMusicPreview || item.track?.spotifyPreview || '';

        const cloneAttrs = isAriaClone
          ? 'tabindex="-1" aria-hidden="true"'
          : '';

        return `
          <button
            type="button"
            class="ticker-pill${isAriaClone ? ' is-clone' : ''}"
            data-track-id="${escapeHtml(trackId)}"
            data-title="${escapeHtml(title)}"
            data-artist="${escapeHtml(artist)}"
            data-preview-url="${escapeHtml(previewUrl)}"
            ${cloneAttrs}
            aria-label="Preview snippet of ${escapeHtml(title)} by ${escapeHtml(artist)}"
            aria-pressed="false"
            title="Preview snippet of &quot;${escapeHtml(title)}&quot; by ${escapeHtml(artist)}"
          >
            <span class="pill-rank">#${item.position}</span>
            <div class="pill-thumb-box">
              <svg class="thumb-progress-ring" viewBox="0 0 32 32" aria-hidden="true">
                <rect class="ring-bg" x="2" y="2" width="28" height="28" rx="6" />
                <rect class="ring-fill" x="2" y="2" width="28" height="28" rx="6" pathLength="100" />
              </svg>
              <img class="pill-thumb" src="${escapeHtml(image)}" alt="" width="24" height="24" loading="lazy" />
              <span class="pill-icon-overlay" aria-hidden="true">
                <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z" />
                </svg>
                <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                </svg>
                <svg class="icon-spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <circle cx="12" cy="12" r="10" stroke-opacity="0.25" />
                  <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round" />
                </svg>
              </span>
            </div>
            <span class="pill-title">${escapeHtml(title)}</span>
            <span class="pill-separator" aria-hidden="true">&ndash;</span>
            <span class="pill-artist">${escapeHtml(artist)}</span>
          </button>
        `;
      })
      .join('');
  }

  async function fetchStats(
    username: string,
    limit: number,
    signal: AbortSignal
  ) {
    const cacheKey = `statsfm_cache_${username}_${limit}`;
    const cached = sessionStorage.getItem(cacheKey);

    if (cached) {
      try {
        const parsed = JSON.parse(cached);
        // Cache valid for 3 minutes (180,000 ms)
        if (
          Date.now() - parsed.timestamp < 180000 &&
          parsed.items?.length > 0
        ) {
          return {
            items: parsed.items,
            isFallback: parsed.isFallback || false
          };
        }
      } catch {
        sessionStorage.removeItem(cacheKey);
      }
    }

    const now = Date.now();
    const twentyFourHoursAgo = now - 24 * 60 * 60 * 1000;

    // 1. Try exact rolling 24 hours (after=${twentyFourHoursAgo})
    let url = `https://api.stats.fm/api/v1/users/${encodeURIComponent(username)}/top/tracks?after=${twentyFourHoursAgo}&limit=${limit}`;
    let res = await fetch(url, { signal });

    if (res.ok) {
      const data = await res.json();
      if (Array.isArray(data.items) && data.items.length > 0) {
        sessionStorage.setItem(
          cacheKey,
          JSON.stringify({
            timestamp: now,
            items: data.items,
            isFallback: false
          })
        );
        return { items: data.items, isFallback: false };
      }
    }

    // 2. Fallback to prior 7 days if 0 scrobbles in the last 24h
    const sevenDaysAgo = now - 7 * 24 * 60 * 60 * 1000;
    url = `https://api.stats.fm/api/v1/users/${encodeURIComponent(username)}/top/tracks?after=${sevenDaysAgo}&limit=${limit}`;
    res = await fetch(url, { signal });
    if (res.ok) {
      const data = await res.json();
      if (Array.isArray(data.items) && data.items.length > 0) {
        sessionStorage.setItem(
          cacheKey,
          JSON.stringify({
            timestamp: now,
            items: data.items,
            isFallback: true
          })
        );
        return { items: data.items, isFallback: true };
      }
    }

    return { items: [], isFallback: false };
  }

  async function setupTicker() {
    const root = document.querySelector<HTMLElement>('[data-music-ticker]');
    if (!root) return;

    const username = root.dataset.username || 'itseebo';
    const limit = parseInt(root.dataset.limit || '5', 10);

    const skeleton = root.querySelector<HTMLElement>('[data-ticker-skeleton]');
    const marquee = root.querySelector<HTMLElement>('[data-ticker-marquee]');
    const primaryTrack = root.querySelector<HTMLElement>(
      '[data-ticker-track-primary]'
    );
    const secondaryTrack = root.querySelector<HTMLElement>(
      '[data-ticker-track-secondary]'
    );

    if (!marquee || !primaryTrack || !secondaryTrack) return;

    if (activeAbortController) {
      activeAbortController.abort();
    }
    activeAbortController = new AbortController();

    try {
      const { items } = await fetchStats(
        username,
        limit,
        activeAbortController.signal
      );

      if (!items || items.length === 0) {
        root.style.display = 'none';
        return;
      }

      primaryTrack.innerHTML = renderTrackNodes(items, false);
      secondaryTrack.innerHTML = renderTrackNodes(items, true);

      // Attach click listeners to all buttons
      marquee.querySelectorAll<HTMLElement>('.ticker-pill').forEach((pill) => {
        pill.addEventListener('click', (e) => {
          e.stopPropagation();
          handlePillClick(pill);
        });
      });

      if (skeleton) skeleton.style.display = 'none';
      marquee.style.display = 'flex';
    } catch (err: any) {
      if (err.name === 'AbortError') return;
      console.warn('Failed to load stats.fm ticker:', err);
      root.style.display = 'none';
    }
  }

  // Cross-audio coordination: stop ticker audio when other players start
  window.addEventListener('music:stop-other-audio', (e: Event) => {
    if ((e as CustomEvent).detail?.source !== 'music-ticker') {
      stopTickerAudio();
    }
  });

  // Astro View Transitions lifecycle
  document.addEventListener('astro:page-load', setupTicker);
  document.addEventListener('astro:before-swap', () => {
    stopTickerAudio();
    if (activeAbortController) {
      activeAbortController.abort();
      activeAbortController = null;
    }
  });
</script>

<style>
  .music-ticker-wrapper {
    width: 100%;
    margin-top: calc(-1 * var(--space-md));
    margin-bottom: var(--space-xs);
  }

  .music-ticker {
    display: flex;
    align-items: center;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.35rem 0.5rem;
    overflow: hidden;
    position: relative;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
    gap: 0.75rem;
    min-height: 44px;
  }

  /* Pinned Left Badge */
  .ticker-badge {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.65rem;
    background: var(--color-border-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.725rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: default;
    user-select: none;
    z-index: 2;
  }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2);
    animation: pulse-dot 2.2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes pulse-dot {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.85);
    }
  }

  /* Viewport with subtle edge gradient fades */
  .ticker-viewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 16px,
      black calc(100% - 16px),
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 16px,
      black calc(100% - 16px),
      transparent 100%
    );
  }

  /* Skeleton Loading */
  .ticker-skeleton {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
    padding: 0.2rem 0.5rem;
  }

  .skeleton-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .skeleton-thumb {
    width: 26px;
    height: 26px;
    border-radius: 4px;
    background: var(--color-border);
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .skeleton-text {
    width: 110px;
    height: 12px;
    border-radius: 3px;
    background: var(--color-border);
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  @keyframes skeleton-pulse {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 0.75;
    }
  }

  /* Continuous Marquee Animation */
  .ticker-marquee {
    display: flex;
    align-items: center;
    width: max-content;
    user-select: none;
    outline: none;
  }

  .ticker-track {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-right: 0.85rem;
    flex-shrink: 0;
    animation: ticker-slide 24s linear infinite;
    will-change: transform;
  }

  @keyframes ticker-slide {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  /* Pause ONLY on mouse hover or explicit keyboard tab focus (focus-visible) */
  .music-ticker:hover .ticker-track,
  .music-ticker:has(:focus-visible) .ticker-track {
    animation-play-state: paused;
  }

  /* Interactive Track Button Pill */
  :global(.ticker-pill) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--color-text);
    background: transparent;
    border: 1px solid transparent;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
    white-space: nowrap;
    cursor: pointer;
    font-family: inherit;
    position: relative;
  }

  :global(.ticker-pill:hover) {
    background-color: var(--color-border-subtle);
    border-color: var(--color-border);
  }

  :global(.ticker-pill:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 1px;
  }

  :global(.pill-rank) {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  /* Thumbnail Box with Subtle Progress Ring (similar to vinyls) */
  :global(.pill-thumb-box) {
    position: relative;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.thumb-progress-ring) {
    position: absolute;
    inset: -2px;
    width: 32px;
    height: 32px;
    transform: rotate(-90deg);
    pointer-events: none;
    overflow: visible;
  }

  :global(.thumb-progress-ring .ring-bg) {
    fill: none;
    stroke: transparent;
    stroke-width: 2;
    transition: stroke 0.2s ease;
  }

  :global(.ticker-pill.is-active .thumb-progress-ring .ring-bg),
  :global(.ticker-pill.is-playing .thumb-progress-ring .ring-bg),
  :global(.ticker-pill.is-paused .thumb-progress-ring .ring-bg) {
    stroke: var(--color-border);
  }

  :global(.thumb-progress-ring .ring-fill) {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.15s linear;
  }

  :global(.pill-thumb) {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    object-fit: cover;
    display: block;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
  }

  /* Subtle Overlay Play/Pause Icon */
  :global(.pill-icon-overlay) {
    position: absolute;
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.38);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.15s ease;
    color: #ffffff;
  }

  /* Show icon on hover or when actively playing/paused/loading */
  :global(.ticker-pill:hover .pill-icon-overlay),
  :global(.ticker-pill.is-playing .pill-icon-overlay),
  :global(.ticker-pill.is-paused .pill-icon-overlay),
  :global(.ticker-pill.is-loading .pill-icon-overlay) {
    opacity: 1;
  }

  :global(.icon-play),
  :global(.icon-pause),
  :global(.icon-spinner) {
    width: 12px;
    height: 12px;
  }

  :global(.icon-play) {
    display: block;
  }

  :global(.icon-pause),
  :global(.icon-spinner) {
    display: none;
  }

  /* While playing: show pause icon */
  :global(.ticker-pill.is-playing .icon-play) {
    display: none;
  }
  :global(.ticker-pill.is-playing .icon-pause) {
    display: block;
  }

  /* While paused: show play icon */
  :global(.ticker-pill.is-paused .icon-play) {
    display: block;
  }
  :global(.ticker-pill.is-paused .icon-pause) {
    display: none;
  }

  /* While loading: show spinner */
  :global(.ticker-pill.is-loading .icon-play),
  :global(.ticker-pill.is-loading .icon-pause) {
    display: none;
  }
  :global(.ticker-pill.is-loading .icon-spinner) {
    display: block;
    animation: pill-spin 0.8s linear infinite;
  }

  @keyframes pill-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  :global(.pill-title) {
    font-size: 0.8125rem;
    font-weight: 550;
    color: var(--color-text);
    max-width: 240px;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.15s ease;
  }

  :global(.pill-separator) {
