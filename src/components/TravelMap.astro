  }

  .trips-dropdown-item.selected .trip-item-check {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .trips-dropdown-menu {
      left: auto;
      right: 0;
      min-width: 240px;
    }
  }

  .map-wrapper {
    position: relative;
    width: 100%;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    view-transition-name: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .travel-map {
    width: 100%;
