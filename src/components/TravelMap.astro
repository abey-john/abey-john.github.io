  @keyframes pin-pulse {
    0% {
      transform: scale(1);
      box-shadow:
        0 0 0 0 rgba(255, 255, 255, 0.9),
        0 2px 6px rgba(0, 0, 0, 0.4);
    }
    50% {
      transform: scale(1.35);
      box-shadow:
        0 0 0 10px rgba(255, 255, 255, 0),
        0 4px 14px rgba(0, 0, 0, 0.4);
    }
    100% {
