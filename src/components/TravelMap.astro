    stroke: rgba(15, 23, 42, 0.75);
    opacity: 0.9;
  }

  :global(html[data-theme='light'] .route-svg-casing) {
    stroke: rgba(255, 255, 255, 0.85);
  }

  @media (prefers-color-scheme: light) {
    :global(html:not([data-theme='dark']) .route-svg-casing) {
      stroke: rgba(255, 255, 255, 0.85);
    }
  }

  :global(.route-svg-line) {
