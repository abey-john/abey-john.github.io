---
import type { CollectionEntry } from 'astro:content';
import { getTripTheme } from '../utils/travelColors';

interface Props {
  places: CollectionEntry<'places'>[];
  trips?: CollectionEntry<'trips'>[];
}

const { places, trips = [] } = Astro.props;

const totalCount = places.length;
const parkCount = places.filter((p) => p.data.type === 'park').length;
const cityCount = places.filter((p) => p.data.type === 'city').length;
const landmarkCount = places.filter((p) => p.data.type === 'landmark').length;

const tripsData = trips.map((t) => t.data);

const placesData = places.map((p) => {
  const matchedTrips: {
    tripId: string;
    tripName: string;
    color: string;
    mode: string;
    stopIndices: number[];
    totalStops: number;
    summary?: string;
  }[] = [];

  for (const t of trips) {
    const indices: number[] = [];
    t.data.stops.forEach((stop, idx) => {
      const matchById = Boolean(stop.placeId && stop.placeId === p.data.id);
      const matchByCoords =
        Math.abs(stop.lat - p.data.lat) < 0.001 &&
        Math.abs(stop.lng - p.data.lng) < 0.001;
      const matchByName =
        stop.name.toLowerCase().trim() === p.data.name.toLowerCase().trim();

      if (matchById || matchByCoords || matchByName) {
        indices.push(idx + 1);
      }
    });

    if (indices.length > 0) {
      matchedTrips.push({
        tripId: t.data.id,
        tripName: t.data.name,
        color: t.data.color,
        mode: t.data.mode || 'drive',
        stopIndices: indices,
        totalStops: t.data.stops.length,
        summary: t.data.summary,
      });
    }
  }

  return {
    id: p.data.id,
    name: p.data.name,
    type: p.data.type,
    lat: p.data.lat,
    lng: p.data.lng,
    country: p.data.country,
    blurb: p.data.blurb,
    photo: p.data.photo,
    link: p.data.link,
    trips: matchedTrips,
  };
});
---

<div class="travel-map-container">
  <div
    class="map-filter-bar"
    role="group"
    aria-label="Filter places by category and view road trip routes"
  >
    <button
      type="button"
      class="filter-pill active"
      data-category="all"
      aria-pressed="true"
      id="filter-pill-all"
    >
      <span class="pill-icon all-icon" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          width="13"
          height="13"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polygon
            points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"
          ></polygon>
        </svg>
      </span>
      <span class="pill-label">All</span>
      <span class="pill-count">{totalCount}</span>
    </button>
    <button
      type="button"
      class="filter-pill filter-park"
      data-category="park"
      aria-pressed="false"
      id="filter-pill-park"
    >
      <span class="pill-icon park-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
          <path d="M12 2L4 12h3.5L5 17h4.5v5h5v-5H19l-2.5-5H20L12 2z"></path>
        </svg>
      </span>
      <span class="pill-label">Parks</span>
      <span class="pill-count">{parkCount}</span>
    </button>
    <button
      type="button"
      class="filter-pill filter-city"
      data-category="city"
      aria-pressed="false"
      id="filter-pill-city"
    >
      <span class="pill-icon city-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
          <path
            d="M15 2H9c-1.1 0-2 .9-2 2v16h10V4c0-1.1-.9-2-2-2zm-4 4h2v2h-2V6zm0 4h2v2h-2v-2zm0 4h2v2h-2v-2z"
          ></path>
        </svg>
      </span>
      <span class="pill-label">Cities</span>
      <span class="pill-count">{cityCount}</span>
    </button>
    <button
      type="button"
      class="filter-pill filter-landmark"
      data-category="landmark"
      aria-pressed="false"
      id="filter-pill-landmark"
    >
      <span class="pill-icon landmark-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="10" height="10" fill="currentColor">
          <path
            d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z"
          ></path>
        </svg>
      </span>
      <span class="pill-label">Landmarks</span>
      <span class="pill-count">{landmarkCount}</span>
    </button>

    {tripsData.length > 0 && (
      <div class="filter-divider" role="separator" aria-orientation="vertical"></div>
      <div class="trips-dropdown-container" id="trips-dropdown-container">
        <button
          type="button"
          class="filter-pill trips-dropdown-trigger"
          id="trips-dropdown-trigger"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="trips-dropdown-menu"
          title="Browse trips & itineraries"
        >
          <span class="pill-icon trip-icon" id="trips-trigger-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="6" cy="19" r="3"></circle>
              <path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"></path>
              <circle cx="18" cy="5" r="3"></circle>
            </svg>
          </span>
          <span class="pill-label" id="trips-trigger-label">Trips</span>
          <span class="pill-count" id="trips-trigger-count">{tripsData.length}</span>
          <svg class="dropdown-chevron" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <div
          class="trips-dropdown-menu"
          id="trips-dropdown-menu"
          role="menu"
          aria-label="Trips and itineraries"
        >
          <div class="trips-dropdown-header">
            <span class="trips-dropdown-title">Trips</span>
            <button
              type="button"
              class="trips-dropdown-clear"
              id="trips-dropdown-clear"
              title="Clear active route"
              style="display: none;"
            >
              Clear Route
            </button>
          </div>
          <div class="trips-dropdown-list">
            {tripsData.map((trip) => {
              const theme = getTripTheme(trip.color);
              return (
                <button
                  type="button"
                  class="trips-dropdown-item"
                  role="menuitem"
                  data-trip-id={trip.id}
                  id={`trip-item-${trip.id}`}
                  style={`--item-accent-color: ${theme.line}; --item-accent-bg: ${theme.bg}; --item-accent-border: ${theme.border}; --item-accent-glow: ${theme.glow};`}
                >
                  <span
                    class="trip-item-dot"
                    style={`background-color: ${theme.line};`}
                    aria-hidden="true"
                  ></span>
                  <span class="trip-item-info">
                    <span class="trip-item-name">{trip.name}</span>
                    <span class="trip-item-meta">
                      {trip.distanceMiles > 0 ? `${trip.distanceMiles} mi` : ''}
                      {trip.distanceMiles > 0 ? ' • ' : ''}
                      {trip.stops.length} stops
                    </span>
                  </span>
                  <span class="trip-item-check" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </span>
                </button>
              );
            })}
          </div>
        </div>
      </div>
    )}
  </div>

  <div class="map-wrapper" id="map-wrapper">
    <div
      id="travel-map"
      class="travel-map"
      data-places={JSON.stringify(placesData)}
      role="region"
      aria-label="Interactive map showing visited places across the United States and the world"
      tabindex="0"
    >
    </div>
    <script type="application/json" id="trips-json" set:html={JSON.stringify(tripsData)}></script>
    <div class="itinerary-stepper" id="itinerary-stepper" role="region" aria-label="Trip Itinerary Stepper" style="display: none;">
      <div class="stepper-content" id="stepper-content" role="button" tabindex="0" title="Start itinerary (Stop 1)">
        <span class="stepper-badge" id="stepper-badge">
          <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="19" r="3"></circle><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"></path><circle cx="18" cy="5" r="3"></circle></svg>
        </span>
        <div class="stepper-info">
          <span class="stepper-counter" id="stepper-counter" style="display: none;"></span>
          <span class="stepper-name" id="stepper-name">Trip Overview</span>
        </div>
      </div>

      <div class="stepper-controls">
        <button type="button" class="stepper-btn stepper-prev" id="stepper-prev" aria-label="Previous stop" title="Previous stop">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <button type="button" class="stepper-btn stepper-next" id="stepper-next" aria-label="Next stop" title="Next stop">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>

        <button type="button" class="stepper-btn stepper-fit" id="stepper-fit" aria-label="View entire route" title="Overview">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 3 21 3 21 9"></polyline>
            <polyline points="9 21 3 21 3 15"></polyline>
            <line x1="21" y1="3" x2="14" y2="10"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
        </button>
      </div>
    </div>

    <div class="map-controls-overlay">
      <div class="map-legend" role="note" aria-label="Map Legend">
        <div
          class="legend-item legend-item-park"
          role="button"
          tabindex="0"
          title="Filter by Parks"
        >
          <span class="legend-icon park-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
              <path d="M12 2L4 12h3.5L5 17h4.5v5h5v-5H19l-2.5-5H20L12 2z"
              ></path>
            </svg>
          </span>
          <span class="legend-text">Park</span>
        </div>
        <div
          class="legend-item legend-item-city"
          role="button"
          tabindex="0"
          title="Filter by Cities"
        >
          <span class="legend-icon city-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
              <path
                d="M15 2H9c-1.1 0-2 .9-2 2v16h10V4c0-1.1-.9-2-2-2zm-4 4h2v2h-2V6zm0 4h2v2h-2v-2zm0 4h2v2h-2v-2z"
              ></path>
            </svg>
          </span>
          <span class="legend-text">City</span>
        </div>
        <div
          class="legend-item legend-item-landmark"
          role="button"
          tabindex="0"
          title="Filter by Landmarks"
        >
          <span class="legend-icon landmark-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="10" height="10" fill="currentColor">
              <path
                d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z"
              ></path>
