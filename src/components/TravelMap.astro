  .trips-dropdown-trigger:hover {
    border-color: var(--color-text-muted);
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.08);
  }

  .trips-dropdown-trigger.active {
    background-color: var(--active-trip-color, #d97706);
    color: #ffffff;
    border-color: var(--active-trip-color, #d97706);
    box-shadow: 0 2px 12px var(--active-trip-glow, rgba(217, 119, 6, 0.35));
  }

  .trips-dropdown-trigger.active .pill-count {
    background-color: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  .dropdown-chevron {
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0.7;
    margin-left: 2px;
  }

  .trips-dropdown-container.open .dropdown-chevron {
    transform: rotate(180deg);
  }

  .trips-dropdown-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 260px;
    max-width: 330px;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
